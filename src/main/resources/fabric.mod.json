{
	"schemaVersion": 1,
	"id": "sprintinghorses",
	"version": "${version}",
	"name": "Sprinting Horses",
	"description": "Adds stamina-based sprinting for horses, donkeys, mules, zombie horses, and skeleton horses.",
	"authors": [
		"Thiago"
	],
	"contact": {
		"issues": "https://discord.gg/pcKQSDgTzh"
	},
	"license": "MIT",
	"icon": "assets/sprintinghorses/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.thbtt.sprintinghorses.SprintingHorses"
		],
		"client": [
			"net.thbtt.sprintinghorses.SprintingHorsesClient"
		],
		"modmenu": [
			"net.thbtt.sprintinghorses.config.SprintingHorsesModMenuApi"
		]
	},
	"mixins": [
		"sprintinghorses.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_dependency}",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_dependency}",
		"fabric-api": ">=${fabric_api_dependency}"
	},
	"suggests": {
		"modmenu": "*"
	}
}
